{
  "name": "@hridayanp/map-draw",
  "version": "0.1.0",
  "description": "Drawing and measuring on a MapLibre map — point, line, polygon, rectangle and circle — built on terra-draw, with controlled GeoJSON output.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "geospatial",
    "gis",
    "maplibre",
    "react",
    "draw",
    "measure",
    "terra-draw",
    "geojson"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hridayanp/geo-utils": "^0.1.0",
    "@hridayanp/map-container": "^0.1.0",
    "@hridayanp/ui": "^0.1.0",
    "terra-draw": "^1.39.0",
    "terra-draw-maplibre-gl-adapter": "^1.5.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "maplibre-gl": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "maplibre-gl": "^5.24.0"
  }
}
